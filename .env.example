# Environment Configuration for Composio Product Ops Agent
# Optional: Composio API Key for native Composio toolsets & web search
COMPOSIO_API_KEY=

# LLM Providers (Provide at least one if re-running LLM extraction live)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Agent Execution Settings
MAX_PARALLEL_WORKERS=5
REQUEST_TIMEOUT_SECONDS=20
CACHE_DIR=.cache
PASS1_OUTPUT_FILE=data/results_pass1.json
PASS2_OUTPUT_FILE=data/results_pass2.json
HUMAN_QUEUE_FILE=data/human_review_queue.json
